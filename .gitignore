node_modules/
.agents/
# `.claude/*` e não `.claude/` de propósito: excluindo o DIRETÓRIO o git nem
# entra nele, e a negação abaixo não teria efeito nenhum. Excluindo o conteúdo,
# a exceção funciona.
.claude/*
# EXCEÇÃO: as skills do projeto são CÓDIGO DE PROCESSO e vão pro repo. Sem isto
# elas morrem na máquina de quem escreveu — que é exatamente o que não pode
# acontecer com conhecimento que custou caro pra descobrir.
# Só as skills REAIS deste projeto. O diretório também guarda symlinks pro
# cache de plugins da máquina (codebase-design, systematic-debugging, ...) —
# esses são do ambiente de quem desenvolve, não do repo, e commitá-los criaria
# links quebrados pra qualquer outra pessoa.
!.claude/skills/
.claude/skills/*
!.claude/skills/vr-quest/
!.claude/skills/test-runner/
skills-lock.json
.venv/
docker-compose.prod.yml
docker-compose.override*.yml
.env

# modelos-fonte dos carros (pesados) — só os otimizados em assets/models vao pro repo
/gumball_car.glb
/low-poly_truck_car_drifter.glb
/mazda_rx7_stylised.glb
/vulcao_em_erupcao_-_erupting_volcano.glb
/castle.glb
/skelly.glb
/castelo_reconstruido_escala_real.glb
/assets/models/boss-castle.v1.glb

# fontes pesadas de personagem/arma — no repo vão só os .optimized.glb
assets/models/Personagens/low_poly_alien_character_rigged.glb
assets/models/Armas/bazooka_rocket_launcher_low_poly.glb

# artefatos gerados pelos testes exploratórios
tests/screenshots/
.playwright-mcp/

# ranking: DADO DE RUNTIME do servidor, não fonte. Ele recria vazio no boot
# (e em produção mora num volume via RANK_FILE). Ficou versionado por engano
# até 2026-08-08, carregando nick e pontuação de partidas reais.
br-rank.json

# evidências geradas localmente pelos harness de captura
output/

# credenciais/infra de deploy (skill global)
deploy.env
